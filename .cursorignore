# =====================================================================
# .cursorignore — что НЕ индексировать и не подсасывать в контекст модели
# Синтаксис как у .gitignore. Файл лежит в корне рабочей папки.
# =====================================================================

# ---------- 1. Миграции БД (alembic) ----------
# Автогенерация, тысячи строк, по делу не нужны.
tower_bot/db/migrations/

# ---------- 2. Автотесты ----------
# Объёмные, в основном моки и фикстуры. Для написания фич не нужны;
# если нужно что-то конкретное — открою точечно вручную.
tower_bot/tests/

# ---------- 3. Статические каталоги предметов и справочники ----------
# Сотни предметов в больших списках, контент-данные, не логика.
tower_bot/game/data/items/
tower_bot/game/items/equipment/catalog/
tower_bot/game/items/equipment/catalog_generated.py
tower_bot/game/data/monsters_catalog.json

# Текстовые справочники (catalog_txt_edit) — внутренний редакт-контент.
tower_bot/catalog_txt_edit/

# Дамп структуры игры (огромный авто-файл).
tower_bot/СТРУКТУРА_ИГРЫ.txt
tower_bot/STRUCTURE.txt
tower_bot/structure.txt

# ---------- 4. Скрипты генерации и тулинг ----------
# Не часть рантайма, не нужны при работе над фичами.
tower_bot/scripts/
tower_bot/tools/

# ---------- 5. Технический мусор и кеши ----------
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.coverage
htmlcov/
build/
dist/
*.egg-info/

# Виртуальные окружения
.venv/
venv/
env/

# Системные/IDE
.idea/
.vscode/
.DS_Store
Thumbs.db

# Контроль версий
.git/

# ---------- 6. Секреты и БД ----------
.env
.env.*
!.env.example
*.db
*.sqlite
*.sqlite3
*.db-shm
*.db-wal

# ---------- 7. Логи и крашдампы ----------
*.log
tower_bot/logs/
logs/

# ---------- 8. Бинарные ассеты ----------
# Не текст, токены модели тратить нет смысла.
*.png
*.jpg
*.jpeg
*.gif
*.webp
*.bmp
*.ico
*.pdf
*.zip
*.tar
*.gz
*.rar
*.7z
*.mp3
*.mp4
*.wav
*.ogg
tower_bot/assets/

# ---------- 9. Сторонние и временные ----------
node_modules/
*.bak
*.tmp
*.swp
