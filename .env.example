BOT_TOKEN=your_token
# Канал для проверки подписки (ежедневка): username без @. Бот должен быть админом канала или иметь доступ к участникам.
REQUIRED_CHANNEL_USERNAME=trial_of_darkness
DB_PATH=./data/tower.db
ADMIN_IDS=123456789,987654321
LOG_LEVEL=INFO
STAMINA_REGEN_INTERVAL=3600
MAX_STAMINA=20
ANTICHEAT_ENABLED=true
SEASON_DURATION_DAYS=30
# Стоимость смены имени героя в настройках (золото)
DISPLAY_NAME_CHANGE_GOLD=250
# Опционально: FSM в Redis (иначе память процесса)
# REDIS_URL=redis://localhost:6379/0
# Прокси до Telegram (PythonAnywhere и т.п.) — или экспорт HTTPS_PROXY=http://proxy:3128
# TELEGRAM_PROXY_URL=http://proxy.server:3128
# Webhook (иначе long polling)
# WEBHOOK_ENABLED=false
# WEBHOOK_BASE_URL=https://your.domain
# WEBHOOK_PATH=/webhook
# WEBHOOK_SECRET=random_secret_string
# WEBAPP_HOST=0.0.0.0
# WEBAPP_PORT=8080
